##############################
# DentaScan Environment Configuration
##############################

# ========== FIREBASE AUTHENTICATION ==========
# Firebase config for shared authentication (Website + Android)
# Get these from your Firebase project settings
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# ========== API CONFIGURATION ==========
# CRITICAL FOR MOBILE: Set to your development machine's LAN IP for Android testing
# Website: Can use relative paths (leave empty or use http://localhost:3000)
# Android: MUST be set to LAN IP like http://192.168.1.100:3000
# Find your IP: Windows - ipconfig, macOS/Linux - ifconfig
VITE_API_URL=http://192.168.1.100:3000

# ========== AI/ML SERVICES ==========
# Google Gemini API Key (for dental plaque detection)
GEMINI_API_KEY=your-google-gemini-api-key-here

# ========== BACKEND SERVICES ==========
# Optional: Flask backend URL for model inference
# Leave empty or set to http://127.0.0.1:5000 for local development
FLASK_BACKEND_URL=http://127.0.0.1:5000

# ========== EMAIL CONFIGURATION ==========
# For Nodemailer (if using Gmail, use App Password not regular password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# ========== SERVER CONFIGURATION ==========
# Node.js environment (development or production)
NODE_ENV=development

# Server port (default 3000)
PORT=3000

# ========== DEVELOPMENT FLAGS ==========
# Enable debug logging (set to true for development, false for production)
DEBUG=false

# Enable CORS (use * for development, restrict to specific origins in production)
CORS_ORIGIN=*

