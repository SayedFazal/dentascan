{
  "name": "dentascan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --require dotenv/config server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e/mega_web_1100.test.ts",
    "test:1800": "vitest run tests/e2e/*_300.test.ts",
    "test:load": "k6 run scripts/load-test.js",
    "security:scan": "node scripts/generateWebSecuritySuite.js && node scripts/generateBackendSecuritySuite.js",
    "dataset:build": "tsx scripts/build-dataset-hashes.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@google/genai": "^1.29.0",
    "@ionic/react": "^8.0.0",
    "@ionic/react-router": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "chart.js": "^4.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "firebase": "^12.17.1",
    "idb": "^8.0.3",
    "ionicons": "^7.2.2",
    "jspdf": "^3.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "nodemailer": "^8.0.7",
    "react": "^19.0.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.0.0"
  }
}
